{
  "opencollection": "1.0.0",
  "info": {
    "name": "CTA Bus Tracker API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get System Time",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/gettime",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns the current Bus Tracker system time."
        }
      ]
    },
    {
      "info": {
        "name": "Routes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Routes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/getroutes",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns the set of CTA bus routes available in Bus Tracker."
        },
        {
          "info": {
            "name": "Get Directions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/getdirections",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "rt",
                "value": "",
                "type": "query"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns the set of valid directions for a given route."
        },
        {
          "info": {
            "name": "Get Patterns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/getpatterns",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "rt",
                "value": "",
                "type": "query"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns route pattern geometry."
        }
      ]
    },
    {
      "info": {
        "name": "Stops",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Stops",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/getstops",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "rt",
                "value": "",
                "type": "query"
              },
              {
                "name": "dir",
                "value": "",
                "type": "query"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns the set of stops served by a route in a given direction."
        }
      ]
    },
    {
      "info": {
        "name": "Vehicles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Vehicles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/getvehicles",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "vid",
                "value": "",
                "type": "query",
                "description": "Comma-separated vehicle IDs."
              },
              {
                "name": "rt",
                "value": "",
                "type": "query",
                "description": "Comma-separated route designators."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns vehicle positions for routes or specific vehicles."
        }
      ]
    },
    {
      "info": {
        "name": "Predictions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Predictions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/getpredictions",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "stpid",
                "value": "",
                "type": "query",
                "description": "Comma-separated stop IDs."
              },
              {
                "name": "rt",
                "value": "",
                "type": "query",
                "description": "Comma-separated route designators."
              },
              {
                "name": "vid",
                "value": "",
                "type": "query",
                "description": "Comma-separated vehicle IDs."
              },
              {
                "name": "top",
                "value": "",
                "type": "query"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns arrival or departure predictions for stops or vehicles."
        }
      ]
    },
    {
      "info": {
        "name": "Bulletins",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Service Bulletins",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ctabustracker.com/bustime/api/v2/getservicebulletins",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "CTA Bus Tracker API key."
              },
              {
                "name": "rt",
                "value": "",
                "type": "query"
              },
              {
                "name": "stpid",
                "value": "",
                "type": "query"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (xml or json). Defaults to XML."
              }
            ]
          },
          "docs": "Returns active service bulletins for routes or stops."
        }
      ]
    }
  ],
  "bundled": true
}